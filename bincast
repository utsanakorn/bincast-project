<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BinCast — Smart Waste Collection</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');

:root{
  --bg:#07110f; --surface:#0e1b18; --surface2:#14241f; --surface3:#1b3029;
  --text:#f4f7f5; --muted:#91a69d; --green:#48e0a5; --lime:#b8f36b;
  --amber:#ffc45c; --red:#ff746c; --line:rgba(255,255,255,.09);
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  min-height:100vh;background:
  radial-gradient(circle at 80% 5%,rgba(72,224,165,.16),transparent 32%),
  radial-gradient(circle at 10% 25%,rgba(184,243,107,.08),transparent 28%),var(--bg);
  color:var(--text);font-family:Inter,system-ui,sans-serif;
  padding:28px 18px 60px;
}
.shell{max-width:980px;margin:auto}
.nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:-.03em}
.brand-mark{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,var(--green),var(--lime));display:grid;place-items:center;color:#082019;font-size:19px}
.live{font:600 11px "JetBrains Mono";color:var(--green);border:1px solid rgba(72,224,165,.3);background:rgba(72,224,165,.08);padding:7px 11px;border-radius:999px}

.hero{
  display:grid;grid-template-columns:1.02fr .98fr;gap:24px;
  background:linear-gradient(145deg,rgba(255,255,255,.06),rgba(255,255,255,.025));
  border:1px solid var(--line);border-radius:28px;padding:28px;
  overflow:hidden;position:relative;
}
.hero:after{content:"";position:absolute;width:280px;height:280px;border-radius:50%;right:-120px;top:-120px;background:rgba(72,224,165,.1);filter:blur(10px)}
.kicker{font:700 11px "JetBrains Mono";letter-spacing:1.5px;text-transform:uppercase;color:var(--green);margin:8px 0 13px}
h1{font-size:clamp(42px,7vw,72px);line-height:.95;letter-spacing:-.065em;margin-bottom:14px}
.sub{font-size:17px;line-height:1.6;color:#b9c8c2;max-width:520px}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}
.tag{font:600 11px "JetBrains Mono";padding:7px 10px;border-radius:8px;background:var(--surface3);color:#c9d7d1;border:1px solid var(--line)}
.hero-art{min-height:360px;border-radius:22px;background:linear-gradient(160deg,#152b24,#091511);border:1px solid var(--line);display:grid;place-items:center;position:relative;overflow:hidden}

.hero-image{
  width:100%;
  height:100%;
  min-height:360px;
  object-fit:contain;
  display:block;
  padding:8px;
}
.hero-art{background:linear-gradient(160deg,#eaf3f0,#dbe8e3);position:relative}
.hero-art .label{z-index:2;background:rgba(7,17,15,.72);padding:7px 9px;border-radius:7px}
.art-caption{z-index:2;background:rgba(7,17,15,.72);padding:7px 9px;border-radius:7px}

.hero-art .label{position:absolute;left:18px;top:17px;font:600 10px "JetBrains Mono";color:var(--muted);letter-spacing:1px}
.bin{width:205px;height:230px;position:relative;filter:drop-shadow(0 25px 25px rgba(0,0,0,.45))}
.bin-body{position:absolute;left:22px;top:42px;width:160px;height:170px;border-radius:16px 16px 25px 25px;background:linear-gradient(90deg,#1c3d32,#244c3f);border:2px solid #396455}
.bin-lid{position:absolute;left:10px;top:22px;width:184px;height:42px;border-radius:12px;background:#2b594a;border:2px solid #477564;transform:rotate(-2deg)}
.bin-handle{position:absolute;left:70px;top:8px;width:66px;height:22px;border:6px solid #477564;border-bottom:0;border-radius:12px 12px 0 0}
.sensor{position:absolute;left:84px;top:84px;width:36px;height:36px;border-radius:50%;background:#07110f;border:3px solid var(--green);box-shadow:0 0 0 7px rgba(72,224,165,.08),0 0 25px rgba(72,224,165,.35)}
.wave{position:absolute;left:68px;top:73px;width:68px;height:58px;border:2px solid transparent;border-right-color:rgba(72,224,165,.45);border-radius:50%;transform:rotate(-25deg)}
.wave2{position:absolute;left:51px;top:63px;width:105px;height:78px;border:2px solid transparent;border-right-color:rgba(72,224,165,.22);border-radius:50%;transform:rotate(-25deg)}
.fill{position:absolute;left:38px;bottom:25px;width:128px;height:8px;background:#07110f;border-radius:9px;overflow:hidden}
.fill i{display:block;width:62%;height:100%;background:linear-gradient(90deg,var(--green),var(--lime));border-radius:9px}
.art-caption{position:absolute;right:16px;bottom:16px;font:600 10px "JetBrains Mono";color:var(--muted)}

.grid{display:grid;grid-template-columns:1.2fr .8fr;gap:18px;margin-top:18px}
.card{background:rgba(14,27,24,.9);border:1px solid var(--line);border-radius:22px;padding:22px}
.card-title{font:700 11px "JetBrains Mono";letter-spacing:1.4px;text-transform:uppercase;color:var(--muted);margin-bottom:16px}
.meter-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:10px}
.pct{font-size:34px;font-weight:800;letter-spacing:-.05em;color:var(--amber)}
.track{height:12px;background:#07110f;border:1px solid var(--line);border-radius:999px;overflow:hidden}
.track i{display:block;width:62%;height:100%;background:linear-gradient(90deg,var(--green),var(--amber));border-radius:999px}
.note{display:flex;justify-content:space-between;gap:10px;margin-top:12px;color:#afc0b8;font-size:13px}
.conf{color:var(--green);font:600 10px "JetBrains Mono";white-space:nowrap}

.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.step{background:var(--surface2);border:1px solid var(--line);border-radius:14px;padding:14px}
.icon{font-size:22px;margin-bottom:9px}.step b{display:block;font-size:13px;margin-bottom:4px}.step span{font-size:11px;color:var(--muted);line-height:1.45}

.description{font-size:14px;line-height:1.75;color:#bdcbc5;margin-top:18px}
.team{margin-top:18px}
.members{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.member{display:flex;align-items:center;gap:11px;padding:12px;background:var(--surface2);border:1px solid var(--line);border-radius:13px;text-decoration:none;color:var(--text)}
.avatar{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:#213c32;color:var(--green);font-weight:800;font-size:12px;flex:none}
.member b{font-size:12px;display:block}.member span{font:500 9px "JetBrains Mono";color:var(--muted);display:block;margin-top:3px}
.footer{display:flex;justify-content:space-between;color:#61756d;font:500 10px "JetBrains Mono";margin-top:18px;padding:0 4px}

@media(max-width:760px){
  .hero-image{min-height:280px;}
  .hero,.grid{grid-template-columns:1fr}.hero-art{min-height:300px}.members{grid-template-columns:1fr}
}
@media(max-width:460px){
  body{padding:16px 12px 40px}.hero{padding:20px;border-radius:22px}h1{font-size:48px}.steps{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="shell">
  <div class="nav">
    <div class="brand"><div class="brand-mark">♻</div><span>BinCast</span></div>
    <div class="live">● SENSOR ONLINE</div>
  </div>

  <section class="hero">
    <div>
      <div class="kicker">Smart Waste Collection</div>
      <h1>Know when<br>the bin is full.</h1>
      <p class="sub">A universal retrofit module that turns ordinary waste bins into connected, predictive smart bins.</p>
      <div class="tags">
        <span class="tag">IoT SENSOR</span><span class="tag">CLOUD</span><span class="tag">AI PREDICTION</span>
      </div>
    </div>

    
    <div class="hero-art">
      <div class="label">BINCAST · SMART WASTE COLLECTION</div>
      <img class="hero-image" src="data:image/png;base64," alt="BinCast smart waste collection system">
      <div class="art-caption">IOT SENSOR · CLOUD · AI</div>
    </div>
  </section>

  <div class="grid">
    <section class="card">
      <div class="card-title">Live prediction</div>
      <div class="meter-head"><span style="color:var(--muted);font:600 11px 'JetBrains Mono'">CURRENT FILL LEVEL</span><strong class="pct">62%</strong></div>
      <div class="track"><i></i></div>
      <div class="note"><span>Pickup recommended in ~2 days</span><span class="conf">91% CONFIDENT</span></div>
    </section>

    <section class="card">
      <div class="card-title">How it works</div>
      <div class="steps">
        <div class="step"><div class="icon">📡</div><b>Sense</b><span>Sensor reads the bin.</span></div>
        <div class="step"><div class="icon">☁️</div><b>Connect</b><span>Data goes to the cloud.</span></div>
        <div class="step"><div class="icon">✦</div><b>Predict</b><span>AI estimates pickup time.</span></div>
      </div>
    </section>
  </div>

  <section class="card" style="margin-top:18px">
    <div class="card-title">Why BinCast</div>
    <p class="description" style="margin-top:0">
      Most bins get picked up on the same schedule every week, whether they're full or not.
      Trucks can waste trips on bins that barely need it, while busy bins may overflow before
      anyone checks. BinCast clips onto existing bins, monitors fill level with a sensor, sends
      readings to the cloud, and uses an AI agent to predict when pickup will be needed.
      Staff can then review and approve the recommended pickup.
    </p>
  </section>

  <section class="card team">
    <div class="card-title">Team</div>
    <div class="members">
      <a class="member" href="https://www.linkedin.com/in/afkmary/" target="_blank"><div class="avatar">MG</div><div><b>Mary Garcia</b><span>Dashboard & Product Design</span></div></a>
      <a class="member" href="https://www.linkedin.com/in/PLACEHOLDER-JARED" target="_blank"><div class="avatar">JL</div><div><b>Jared Lopez</b><span>Hardware & Edge Device</span></div></a>
      <a class="member" href="https://www.linkedin.com/in/utsanakorn" target="_blank"><div class="avatar">UK</div><div><b>Utsanakorn (Kate) Chinkonglar</b><span>Cloud Backend & Security</span></div></a>
      <a class="member" href="https://www.linkedin.com/in/PLACEHOLDER-AHN" target="_blank"><div class="avatar">AP</div><div><b>Ahn Quan Pham</b><span>AI Agent & Workflow</span></div></a>
      <a class="member" href="https://www.linkedin.com/in/parneet-kaur-471611318/" target="_blank"><div class="avatar">PK</div><div><b>Parneet Kaur</b><span>Testing & Demo Support</span></div></a>
    </div>
  </section>

  <div class="footer"><span>INDUSTRY · WASTE MANAGEMENT</span><span>SAIT · AUG 2026</span></div>
</div>
</body>
</html>
